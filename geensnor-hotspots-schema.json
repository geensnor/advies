{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geensnor.nl/schemas/geensnor-hotspots-schema.json",
  "title": "Geensnor Hotspots",
  "allOf": [
    {
      "$ref": "https://geojson.org/schema/FeatureCollection.json"
    }
  ],
  "type": "object",
  "required": ["type", "name", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "type": { "const": "FeatureCollection" },
    "name": { "type": "string" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/geensnorFeature" }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "geensnorFeature": {
      "allOf": [
        {
          "$ref": "https://geojson.org/schema/Feature.json"
        }
      ],
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": { "$ref": "https://geojson.org/schema/Point.json" },
        "properties": {
          "type": "object",
          "required": ["name", "category", "description", "placeName"],
          "properties": {
            "name": { "type": "string" },
            "oneliner": {
              "type": "string",
              "description": "Korte omschrijving. Pakkende knaller!"
            },
            "description": {
              "type": "string",
              "description": "Uitgebreide omschrijving"
            },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" },
            "category": {
              "enum": [
                "bar",
                "restaurant",
                "trailerhelling",
                "overig",
                "overnachten",
                "koffie",
                "muziek",
                "strand",
                "snackbar",
                "lunch"
              ]
            },
            "avoid": {
              "type": "boolean",
              "description": "true bij doodshoofd! Plaats om ver weg van te blijven!"
            },
            "placeName": {
              "type": "string",
              "description": "Handig bij het zoeken"
            },
            "image": {
              "type": "string",
              "description": "URL naar een afbeelding"
            },
            "website": {
              "type": "string",
              "description": "URL van de website"
            }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    }
  }
}
