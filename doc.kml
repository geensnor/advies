			<Placemark>
				<name>Beers &amp; Barrels</name>
				<description><![CDATA[Goh....oude gracht en toch ok. Dat is op zichzelf al een tip waardig. Je eet hier burgers en beers.<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-1081</styleUrl>
