					<Data name='gx_image_links'>
						<value>http://static.wixstatic.com/media/df86b1_19d54daec189d9a3944d3f6e8a4a940e.jpg_srz_660_470_75_22_0.50_1.20_0.00_jpg_srz</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>3.920849999999973,51.647182,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Bar petit Restaurant 't Oliegeultje</name>
				<description><![CDATA[Leuk uitzicht, goede broodjes, fijn terras.<br><br>gx_image_links: http://1.bp.blogspot.com/-DKT4aZwG-Fk/TjkcmNwu9xI/AAAAAAAAAH4/fv3zkLiyciY/s1600/DSCN5131.JPG]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://1.bp.blogspot.com/-DKT4aZwG-Fk/TjkcmNwu9xI/AAAAAAAAAH4/fv3zkLiyciY/s1600/DSCN5131.JPG</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>3.754766000000018,51.674131,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Lodewijk Nijmegen BV</name>
				<description><![CDATA[Bijzonder lekker eten en daarom vaak druk. De drukte en het de kleine oppervlakte zorgen ervoor dat je erg dicht op elkaar zit. Prijs/kwaliteit verhouding is prima!<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value></value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>5.873788999999989,51.842526,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Restaurant Gusto</name>
				<description><![CDATA[Ow wow. Dit is een partij prima zeg. Wij hadden eerst het assorti met hapjes als voorgerecht (2pers) met echt top worst en vlees en brood en daarna een hele lekker pizza. Je zit er ook leuk en het is niet gek duur. <br><br>gx_image_links: http://imagene.youropi.com/restaurant-gusto-rotterdam-1(p:restaurant,14469)(c:0).jpg]]></description>
				<styleUrl>#icon-1081</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://imagene.youropi.com/restaurant-gusto-rotterdam-1(p:restaurant,14469)(c:0).jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>4.480282999999986,51.916873,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>No Fire, No Glory!</name>
				<description><![CDATA[Top koffie!<br><br>gx_image_links: http://4.bp.blogspot.com/-sUYY7eu8mys/TxhpOF4aSFI/AAAAAAAAA9U/IgjD3pzLo20/s1600/Ryke-31.jpg]]></description>
				<styleUrl>#icon-991</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://4.bp.blogspot.com/-sUYY7eu8mys/TxhpOF4aSFI/AAAAAAAAA9U/IgjD3pzLo20/s1600/Ryke-31.jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>13.420456000000058,52.536666,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Beakers</name>
				<description><![CDATA[Voor een goed ontbijt!<br><br>gx_image_links: http://itsrainingflamingosandfoxes.files.wordpress.com/2013/12/dsc00867_fotor.jpg]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://itsrainingflamingosandfoxes.files.wordpress.com/2013/12/dsc00867_fotor.jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>13.422913999999993,52.545141,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Omoni</name>
				<description><![CDATA[Waarschijnlijk de beste sushi in Berlijn<br><br>gx_image_links: https://irs2.4sqi.net/img/general/600x600/330574_4MSUtEDbUhGbPO9N1Zt9yJI1FMeQpMFLg09hbjL5Bx8.jpg]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>https://irs2.4sqi.net/img/general/600x600/330574_4MSUtEDbUhGbPO9N1Zt9yJI1FMeQpMFLg09hbjL5Bx8.jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>13.409245000000055,52.54906,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>K.i.e.z.e.v.</name>
				<description><![CDATA[De enige normale plek in dessau. Biertjes drinken in een kroeg/bioscoop. Neem de augustiner.<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-979</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value></value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>12.246687000000065,51.839611000000005,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Brauhaus Zum Alten Dessauer</name>
				<description><![CDATA[Klassiek duitse kaart. Schnitzel met asperges is lekker<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value></value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>12.245622000000026,51.835423,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>In-Credible</name>
				<description><![CDATA[In heel veel gevallen het restaurant waar je naar opzoek bent. Lekker eten voor een prima prijs (11 euro voor een lekkere hamburger). Het terras ligt aan een drukke weg, maar heeft wel lang zon. De bediening is erg goed en vriendelijk. En als je moe bent kun je er ook nog slapen! (het is ook een hotel)<br><br>gx_image_links: http://www.centrumnijmegen.nl/images/SchulteSchultz%20fotografie%20copyright%20hotel%20Credible-14.jpg]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://www.centrumnijmegen.nl/images/SchulteSchultz%20fotografie%20copyright%20hotel%20Credible-14.jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>5.869205999999963,51.846316,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>1619 Eten &amp; Drinken</name>
				<description><![CDATA[Restaurants in jachthavens kunnen flink tegenvallen, maar dit is een uitzondering. Hier kun je prima eten. In een VT wonen achtig interieur serveert een ietwat jonge en onervaren bediening lekker eten. ca. 20 euro voor een hoofdgerecht.<br><br>gx_image_links: http://www.hierinwestfriesland.nl/img/categorie/thumb/large/1619.jpg]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://www.hierinwestfriesland.nl/img/categorie/thumb/large/1619.jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>5.184894999999983,52.745929,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Loulou' Friendly diner</name>
				<description><![CDATA[Op Amerikaanse leest geschoeid restaurant. Heel erg lekkere hamburgers en het personeel is inderdaad "Friendly" zoals de naam al suggereert. Niet heel prijzig (maar best wel een beetje) in een zeer prijzige buurt.<br><br>gx_image_links: http://media-cdn.tripadvisor.com/media/photo-s/02/e2/ed/10/loulou-friendly-diner.jpg]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://media-cdn.tripadvisor.com/media/photo-s/02/e2/ed/10/loulou-friendly-diner.jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>2.344728000000032,48.851144,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Les p'tites indécises</name>
				<description><![CDATA[Smakelijk en zeer betaalbaar restaurant aan geinig pleintje. Voor 15 euro heb je een voor- en hoofdgerecht met een glas wijn. Geschikt voor diner en stevige lunch. Als je zin hebt om lekker frans te doen, kun je de boeuf tartaar nemen.<br><br>gx_image_links: http://resto-de-paris.obsession.nouvelobs.com/wp-content/uploads/2011/06/les-petites-ind%C3%A9cises-1.jpg]]></description>
				<styleUrl>#icon-1085</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value>http://resto-de-paris.obsession.nouvelobs.com/wp-content/uploads/2011/06/les-petites-ind%C3%A9cises-1.jpg</value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>2.372188999999935,48.86641,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Café en restaurant De Kluizenaar</name>
				<description><![CDATA[Cafe met terras. Veel verschillende soorten bier. Je kan hier tapas eten maar verwacht geen hoogstandjes.<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-979</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
						<value></value>
					</Data>
				</ExtendedData>
				<Point>
					<coordinates>5.855987000000027,51.839505,0.0</coordinates>
				</Point>
			</Placemark>
		</Folder>
