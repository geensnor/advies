			</Placemark>
			<Placemark>
				<name>Cafe Averechts</name>
				<description><![CDATA[Vrijwilligerscafe. Leuke sfeer, lekker bier. Wel erg voor de locals/buurtbewoners.<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-979</styleUrl>
