					<coordinates>5.105953099999965,52.0974219,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>O-Café</name>
				<description><![CDATA[Lekkere koffie met uitzicht op de bouwput van utrecht. Tip is het brood want dat kun je kopen en is erg lekker.<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-991</styleUrl>
