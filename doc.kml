					<coordinates>1.6101280000000318,50.765963,0.0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Viskeete</name>
				<description><![CDATA[Top vis. Soort mega snackbar/bistro met verse heerlijke vis. Vis vis vis<br><br>gx_image_links: ]]></description>
				<styleUrl>#icon-1081</styleUrl>
				<ExtendedData>
					<Data name='gx_image_links'>
