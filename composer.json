{
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage",
    "check": "phpstan analyze"
  },
  "autoload": {
    "psr-4": {
      "Geensnor\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "pestphp/pest": "^5.3",
    "phpstan/phpstan": "^2.3"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
