{
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage",
    "check": "phpstan analyze",
    "generate:openapi": "vendor/bin/openapi src --output api/openapi.yaml"
  },
  "autoload": {
    "psr-4": {
      "Geensnor\\Advies\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "require": {
    "zircote/swagger-php": "^6.20"
  },
  "require-dev": {
    "pestphp/pest": "^5.3",
    "phpstan/phpstan": "^2.3"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
